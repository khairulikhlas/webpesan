# ============================================================
#  CRM CINTA DAKWAH - contoh konfigurasi
#  Salin file ini menjadi ".env" lalu isi nilainya.
#  Perintah: cp .env.example .env
# ============================================================

# Port tempat aplikasi berjalan di server kamu
PORT=3000

# Alamat publik aplikasi (dipakai untuk menampilkan URL webhook di halaman Pengaturan)
# Contoh: https://crm.cintadakwah.or.id
PUBLIC_URL=http://localhost:3000

# Kunci rahasia untuk mengenkripsi Access Token di database.
# WAJIB diisi di server produksi. Buat dengan perintah:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Kalau dikosongkan, aplikasi membuat kunci otomatis di data/keyfile.
ENCRYPTION_KEY=

# Akun admin pertama (opsional). Kalau diisi, admin dibuat otomatis saat start.
# Kalau dikosongkan, buka http://localhost:3000 dan isi form pendaftaran admin pertama.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Administrator

# ------------------------------------------------------------
# Kredensial WhatsApp Cloud API (opsional di sini).
# Lebih mudah diisi lewat halaman "Pengaturan" di aplikasi.
# Kalau diisi di sini, nilainya dipakai sebagai nilai awal.
# ------------------------------------------------------------
WA_PHONE_NUMBER_ID=
WA_BUSINESS_ACCOUNT_ID=
WA_ACCESS_TOKEN=
WA_APP_SECRET=
WA_VERIFY_TOKEN=
WA_GRAPH_VERSION=v23.0
